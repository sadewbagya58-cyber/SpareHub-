# SpareHub Environment Configuration Template
# Copy this file to .env.local for local development.

# Public Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key-placeholder

# Supabase Server Secret / Service Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key-placeholder
SUPABASE_SECRET_KEY=your-server-secret-key-placeholder
