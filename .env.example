# SpareHub Environment Configuration Template
# Copy this file to .env.local for local development.

# Public Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Connectivity (To be configured in Phase 3 & 4)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-placeholder

# Supabase Server Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key-placeholder
